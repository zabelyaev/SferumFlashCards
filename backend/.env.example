POSTGRES_DB=fastapi_starter
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres
DB_MIGRATION_USER=fastapi_starter_owner
DB_MIGRATION_PASSWORD=app_owner
DB_APP_USER=fastapi_starter_app
DB_APP_PASSWORD=app

APP_WORKERS=4
APP_BACKLOG=4096
APP_KEEP_ALIVE_SECONDS=30
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

FSRS_OPTIMIZER_HOUR_UTC=21
FSRS_OPTIMIZER_CPUS=1.0
FSRS_OPTIMIZER_MEM_LIMIT=2g

APP_CONFIG__AUTH__APP_KEY=
APP_CONFIG__CORS__ORIGINS=["*"]

APP_CONFIG__DOCUMENTATION__PREFIX=/internal
APP_CONFIG__DOCUMENTATION__PASSWORD=
APP_CONFIG__DOCUMENTATION__LOGIN=admin
APP_CONFIG__DOCUMENTATION__ENABLED=false
